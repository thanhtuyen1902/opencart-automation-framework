<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--chạy song song-->

<suite name="CrossBrowserSuite-Parallel" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.opencart.automation.utilities.ExtentReportListener" />
    </listeners>

    <test name="Chrome Test">
        <parameter name="browser" value="chrome" />
        <classes>
            <!--                Register func-->
            <class name="com.opencart.automation.testcases.functional.RegisterTest">
                <methods>
                    <include name="testRegisterSuccess"/>
                </methods>
            </class>
            <!--            Login func-->
            <class name="com.opencart.automation.testcases.functional.LoginTest">
                <methods>
                    <include name="testLoginSuccess"/>
                </methods>
            </class>
            <!--            Search func-->
            <class name="com.opencart.automation.testcases.functional.SearchTest">
                <methods>
                    <include name="testSearchExactKeyword"/>
                </methods>
            </class>
            <!--            Cart func-->
            <class name="com.opencart.automation.testcases.functional.AddToCartTest">
                <methods>
                    <include name="testAddToCartFromHomePage"/>
                    <include name="testAddToCartFromProductPage"/>
                </methods>
            </class>
            <class name="com.opencart.automation.testcases.e2e.E2ELoginFlowTest"/>
        </classes>
    </test>

    <test name="Firefox Test">
        <parameter name="browser" value="firefox" />
        <classes>
            <!--                Register func-->
            <class name="com.opencart.automation.testcases.functional.RegisterTest">
                <methods>
                    <include name="testRegisterSuccess"/>
                </methods>
            </class>
            <!--            Login func-->
            <class name="com.opencart.automation.testcases.functional.LoginTest">
                <methods>
                    <include name="testLoginSuccess"/>
                </methods>
            </class>
            <!--            Search func-->
            <class name="com.opencart.automation.testcases.functional.SearchTest">
                <methods>
                    <include name="testSearchExactKeyword"/>
                </methods>
            </class>
            <!--            Cart func-->
            <class name="com.opencart.automation.testcases.functional.AddToCartTest">
                <methods>
                    <include name="testAddToCartFromHomePage"/>
                    <include name="testAddToCartFromProductPage"/>
                </methods>
            </class>
            <class name="com.opencart.automation.testcases.e2e.E2ELoginFlowTest"/>
        </classes>
    </test>


    <test name="Edge Test">
        <parameter name="browser" value="edge" />
        <classes>
            <!--                Register func-->
            <class name="com.opencart.automation.testcases.functional.RegisterTest">
                <methods>
                    <include name="testRegisterSuccess"/>
                </methods>
            </class>
            <!--            Login func-->
            <class name="com.opencart.automation.testcases.functional.LoginTest">
                <methods>
                    <include name="testLoginSuccess"/>
                </methods>
            </class>
            <!--            Search func-->
            <class name="com.opencart.automation.testcases.functional.SearchTest">
                <methods>
                    <include name="testSearchExactKeyword"/>
                </methods>
            </class>
            <!--            Cart func-->
            <class name="com.opencart.automation.testcases.functional.AddToCartTest">
                <methods>
                    <include name="testAddToCartFromHomePage"/>
                    <include name="testAddToCartFromProductPage"/>
                </methods>
            </class>
            <class name="com.opencart.automation.testcases.e2e.E2ELoginFlowTest"/>
        </classes>
    </test>

</suite>


